<?xml version="1.0" encoding="utf-8"?>
<Window
	x:Class="ZenStationShell.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:ZenStationShell">

	<Grid x:Name="Root" Background="#05060A" KeyDown="Root_KeyDown" CharacterReceived="Root_CharacterReceived">

		<Grid.Resources>
			<!-- Flis: ingen firkantet markering. Valgt flis skaleres opp og får hvit ramme. -->
			<Style x:Key="TileItemStyle" TargetType="ListViewItem">
				<Setter Property="Padding" Value="0" />
				<Setter Property="Margin" Value="0" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="VerticalContentAlignment" Value="Stretch" />
				<Setter Property="UseSystemFocusVisuals" Value="False" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ListViewItem">
							<Grid x:Name="Tile" Margin="7,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
								<Grid.RenderTransform>
									<CompositeTransform x:Name="ScaleT" />
								</Grid.RenderTransform>
								<ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}"
									ContentTemplate="{TemplateBinding ContentTemplate}" />
								<Border x:Name="Highlight" Opacity="0" IsHitTestVisible="False" CornerRadius="14" BorderThickness="4">
									<Border.BorderBrush>
										<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
											<LinearGradientBrush.RelativeTransform>
												<RotateTransform x:Name="HlRot" CenterX="0.5" CenterY="0.5" />
											</LinearGradientBrush.RelativeTransform>
											<GradientStop Color="#FFFF3B7A" Offset="0.0" />
											<GradientStop Color="#FFFFB020" Offset="0.2" />
											<GradientStop Color="#FF3BFF8A" Offset="0.4" />
											<GradientStop Color="#FF20C8FF" Offset="0.6" />
											<GradientStop Color="#FF8A5CFF" Offset="0.8" />
											<GradientStop Color="#FFFF3B7A" Offset="1.0" />
										</LinearGradientBrush>
									</Border.BorderBrush>
								</Border>
								<VisualStateManager.VisualStateGroups>
									<VisualStateGroup x:Name="CommonStates">
										<VisualState x:Name="Normal">
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="ScaleT" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
												<DoubleAnimation Storyboard.TargetName="ScaleT" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
												<DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
											</Storyboard>
										</VisualState>
										<VisualState x:Name="PointerOver">
											<VisualState.Setters>
												<Setter Target="Bg.Background" Value="#26FFFFFF" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Pressed">
											<VisualState.Setters>
												<Setter Target="Bg.Background" Value="#33FFFFFF" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Selected">
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="ScaleT" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.14" />
												<DoubleAnimation Storyboard.TargetName="ScaleT" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.14" />
												<DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
											</Storyboard>
										</VisualState>
										<VisualState x:Name="PointerOverSelected">
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="ScaleT" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.14" />
												<DoubleAnimation Storyboard.TargetName="ScaleT" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.14" />
												<DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
											</Storyboard>
										</VisualState>
										<VisualState x:Name="PressedSelected">
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="ScaleT" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.14" />
												<DoubleAnimation Storyboard.TargetName="ScaleT" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.14" />
												<DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
											</Storyboard>
										</VisualState>
									</VisualStateGroup>
								</VisualStateManager.VisualStateGroups>
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!-- Menyrad: avrundet markering uten blå strek -->
			<Style x:Key="MenuItemStyle" TargetType="ListViewItem">
				<Setter Property="Padding" Value="0" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="UseSystemFocusVisuals" Value="False" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ListViewItem">
							<Border x:Name="Bg" CornerRadius="14" Margin="0,2" Background="Transparent">
								<ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
								<VisualStateManager.VisualStateGroups>
									<VisualStateGroup x:Name="CommonStates">
										<VisualState x:Name="Normal" />
										<VisualState x:Name="PointerOver" />
										<VisualState x:Name="Pressed" />
										<VisualState x:Name="Selected">
											<VisualState.Setters>
												<Setter Target="Bg.Background" Value="#3DFFFFFF" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="PointerOverSelected">
											<VisualState.Setters>
												<Setter Target="Bg.Background" Value="#3DFFFFFF" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="PressedSelected">
											<VisualState.Setters>
												<Setter Target="Bg.Background" Value="#3DFFFFFF" />
											</VisualState.Setters>
										</VisualState>
									</VisualStateGroup>
								</VisualStateManager.VisualStateGroups>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</Grid.Resources>


		<!-- Bakgrunn: hero-bilde for valgt spill -->
		<Image x:Name="HeroImage" Stretch="UniformToFill" Opacity="0.6" />
		<Rectangle>
			<Rectangle.Fill>
				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
					<GradientStop Color="#99000000" Offset="0.0" />
					<GradientStop Color="#00000000" Offset="0.30" />
					<GradientStop Color="#F005060A" Offset="0.88" />
				</LinearGradientBrush>
			</Rectangle.Fill>
		</Rectangle>
		<Rectangle>
			<Rectangle.Fill>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
					<GradientStop Color="#CC05060A" Offset="0.0" />
					<GradientStop Color="#00000000" Offset="0.6" />
				</LinearGradientBrush>
			</Rectangle.Fill>
		</Rectangle>

		<Grid x:Name="HomeLayer">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Toppfelt -->
			<Grid Grid.Row="0" Margin="64,40,64,0" ColumnSpacing="24">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock x:Name="HeaderName" Text="ZenLauncher" FontSize="22" FontWeight="SemiBold" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
				<ScrollViewer x:Name="ChipsScroll" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
					HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
					SizeChanged="ChipsScroll_SizeChanged">
					<StackPanel x:Name="ChipsPanel" Orientation="Horizontal" Spacing="34">
					</StackPanel>
				</ScrollViewer>
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="22" HorizontalAlignment="Right" VerticalAlignment="Center">
					<StackPanel x:Name="PadStatus" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" VerticalAlignment="Center">
						<FontIcon Glyph="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#E6FFFFFF" />
						<TextBlock x:Name="PadBatteryText" FontSize="18" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
					</StackPanel>
					<FontIcon x:Name="BtIcon" Glyph="&#xE702;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#E6FFFFFF" Visibility="Collapsed" />
					<FontIcon x:Name="NetIcon" Glyph="&#xE701;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#E6FFFFFF" />
					<StackPanel x:Name="DeviceBattery" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" VerticalAlignment="Center">
						<FontIcon x:Name="DeviceBatteryIcon" Glyph="&#xE83F;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#E6FFFFFF" />
						<TextBlock x:Name="DeviceBatteryText" FontSize="18" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
					</StackPanel>
					<TextBlock x:Name="ClockText" FontSize="22" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
					<Button Content="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="20" Padding="12,8" Background="#33FFFFFF" CornerRadius="10"
						Click="ConsoleToDesktop_Click" ToolTipService.ToolTip="Bytt til Desktop-modus (vindu, mus og tastatur)" />
				</StackPanel>
			</Grid>

			<!-- Tittel for valgt spill -->
			<StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="64,0,64,28" Spacing="8">
				<TextBlock x:Name="TitleText" FontSize="60" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
				<TextBlock x:Name="MetaText" FontSize="20" Foreground="#CCFFFFFF" />
				<TextBlock x:Name="HintText" FontSize="18" Foreground="#B3FFFFFF" />
				<TextBlock x:Name="SearchText" Visibility="Collapsed" FontSize="24" Foreground="#FFFFD34D" />
				<TextBlock x:Name="EmptyText" Visibility="Collapsed" FontSize="22" Foreground="#CCFFFFFF" TextWrapping="Wrap" />
			</StackPanel>

			<!-- Spillrad -->
			<ListView x:Name="GameList" Grid.Row="2" Margin="56,0,56,56" Height="360"
				SelectionMode="Single" SingleSelectionFollowsFocus="True" IsItemClickEnabled="True"
				ItemContainerStyle="{StaticResource TileItemStyle}"
				ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
				ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
				SelectionChanged="GameList_SelectionChanged" ItemClick="GameList_ItemClick"
				PointerWheelChanged="GameList_PointerWheelChanged" RightTapped="GameList_RightTapped">
				<ListView.ItemsPanel>
					<ItemsPanelTemplate>
						<ItemsStackPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ListView.ItemsPanel>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="local:TileVm">
						<Grid Width="200" Height="300" CornerRadius="14" Background="#1B1E2A">
							<TextBlock Text="{x:Bind Glyph}" FontSize="84" FontWeight="SemiBold" Foreground="#55FFFFFF"
								HorizontalAlignment="Center" VerticalAlignment="Center" />
							<Image Source="{x:Bind Icon}" Width="120" Height="120" Stretch="Uniform"
								HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24" />
							<TextBlock Text="{x:Bind Name}" Margin="14,14,14,46" TextWrapping="Wrap" FontSize="18"
								Foreground="#CCFFFFFF" VerticalAlignment="Bottom" />
							<Image Source="{x:Bind Cover}" Width="200" Height="300" Stretch="UniformToFill"
								HorizontalAlignment="Left" VerticalAlignment="Top" />
							<TextBlock Text="{x:Bind Star}" Foreground="#FFFFD34D" FontSize="28"
								HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0" />
							<Border Visibility="{x:Bind StoreVisibility}" Background="{x:Bind StoreBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
								Margin="10,0,0,10" Padding="9,3" CornerRadius="8">
								<TextBlock Text="{x:Bind StoreLabel}" FontSize="12" FontWeight="Bold" Foreground="White" CharacterSpacing="40" />
							</Border>
							<Border Visibility="{x:Bind BadgeVisibility}" HorizontalAlignment="Left" VerticalAlignment="Top"
								Margin="10,10,0,0" Padding="10,4" CornerRadius="10" Background="#E6154D33">
								<TextBlock Text="{x:Bind Badge}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
							</Border>
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</Grid>

		<!-- Desktop-modus: bibliotek med liste til venstre og detaljer til høyre (som Steams vanlige visning) -->
		<Grid x:Name="DesktopLayer" Visibility="Collapsed" Background="#FF0C0E15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="360" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- Høyre: heltebilde og detaljer (ligger bak tittellinjen) -->
			<Grid x:Name="DesktopDetail" Grid.Column="1">
				<Image x:Name="DesktopHero" Stretch="UniformToFill" VerticalAlignment="Top" Height="560" Opacity="0.85" />
				<Rectangle VerticalAlignment="Top" Height="560">
					<Rectangle.Fill>
						<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
							<GradientStop Color="#990C0E15" Offset="0.0" />
							<GradientStop Color="#000C0E15" Offset="0.30" />
							<GradientStop Color="#CC0C0E15" Offset="0.80" />
							<GradientStop Color="#FF0C0E15" Offset="1.0" />
						</LinearGradientBrush>
					</Rectangle.Fill>
				</Rectangle>
				<Rectangle VerticalAlignment="Top" Height="560">
					<Rectangle.Fill>
						<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
							<GradientStop Color="#CC0C0E15" Offset="0.0" />
							<GradientStop Color="#00000000" Offset="0.55" />
						</LinearGradientBrush>
					</Rectangle.Fill>
				</Rectangle>

				<ScrollViewer x:Name="DesktopContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<StackPanel Margin="56,0,56,40">
						<!-- Topp: poster, tittel og knapper ligger over heltebildet -->
						<Grid Height="440" ColumnSpacing="28">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid Width="150" Height="225" CornerRadius="12" Background="#1B1E2A" VerticalAlignment="Bottom"
								BorderBrush="#33FFFFFF" BorderThickness="1">
								<TextBlock x:Name="DesktopPosterGlyph" FontSize="60" FontWeight="SemiBold" Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
								<Image x:Name="DesktopPosterIcon" Width="90" Height="90" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
								<Image x:Name="DesktopPosterCover" Stretch="UniformToFill" />
							</Grid>
							<StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="10">
								<Border x:Name="DesktopStoreBadge" HorizontalAlignment="Left" Padding="12,4" CornerRadius="10" Background="#33FFFFFF">
									<TextBlock x:Name="DesktopStoreText" FontSize="13" FontWeight="SemiBold" Foreground="White" CharacterSpacing="60" />
								</Border>
								<TextBlock x:Name="DesktopTitle" FontSize="46" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
								<StackPanel Orientation="Horizontal" Spacing="40" Margin="0,0,0,4">
									<StackPanel x:Name="DesktopStat1" Spacing="2">
										<TextBlock x:Name="DesktopStat1Label" FontSize="12" Foreground="#88FFFFFF" CharacterSpacing="80" />
										<TextBlock x:Name="DesktopStat1Value" FontSize="20" Foreground="White" />
									</StackPanel>
									<StackPanel x:Name="DesktopStat2" Spacing="2">
										<TextBlock x:Name="DesktopStat2Label" FontSize="12" Foreground="#88FFFFFF" CharacterSpacing="80" />
										<TextBlock x:Name="DesktopStat2Value" FontSize="20" Foreground="White" />
									</StackPanel>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="10">
									<Button x:Name="DesktopPlay" Content="Spill" FontSize="22" FontWeight="SemiBold" Padding="52,12" CornerRadius="10"
										Style="{StaticResource AccentButtonStyle}" Click="DesktopPlay_Click" ToolTipService.ToolTip="Start (Enter, dobbeltklikk)" />
									<Button x:Name="DesktopFav" Content="★" FontSize="22" Padding="18,12" CornerRadius="10" Click="DesktopFav_Click" ToolTipService.ToolTip="Favoritt (F2)" />
									<Button x:Name="DesktopMore" Content="⋯  Flere valg" FontSize="18" Padding="20,12" CornerRadius="10" Click="DesktopMore_Click" ToolTipService.ToolTip="Spillmeny (F3, høyreklikk)" />
								</StackPanel>
							</StackPanel>
						</Grid>

						<!-- Under: om spillet til venstre, detaljer til høyre -->
						<Grid ColumnSpacing="40" Margin="0,32,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="360" />
							</Grid.ColumnDefinitions>
							<StackPanel Spacing="26">
							<StackPanel x:Name="DesktopInfo" Spacing="14" Visibility="Collapsed">
								<StackPanel Orientation="Horizontal" Spacing="12">
									<TextBlock x:Name="DesktopInfoHeader" Text="OM SPILLET" FontSize="12" Foreground="#88FFFFFF" CharacterSpacing="80" VerticalAlignment="Center" />
									<StackPanel x:Name="DesktopChips" Orientation="Horizontal" Spacing="8" />
								</StackPanel>
								<TextBlock x:Name="DesktopDesc" FontSize="16" LineHeight="24" Foreground="#DDFFFFFF" TextWrapping="Wrap" MaxLines="6"
									TextTrimming="CharacterEllipsis" MaxWidth="900" HorizontalAlignment="Left" />
								<ScrollViewer x:Name="DesktopShotsScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
									HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
									<StackPanel x:Name="DesktopShots" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8" />
								</ScrollViewer>
							</StackPanel>
							<!-- Plugin: egne skjermbilder -->
							<StackPanel x:Name="DesktopMyShotsPanel" Spacing="10" Visibility="Collapsed">
								<TextBlock Text="DINE SKJERMBILDER" FontSize="12" Foreground="#88FFFFFF" CharacterSpacing="80" />
								<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
									<StackPanel x:Name="DesktopMyShots" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8" />
								</ScrollViewer>
							</StackPanel>
							<!-- Plugin: notater -->
							<StackPanel x:Name="DesktopNotes" Spacing="10" Visibility="Collapsed">
								<TextBlock Text="NOTATER" FontSize="12" Foreground="#88FFFFFF" CharacterSpacing="80" />
								<TextBox x:Name="DesktopNotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxWidth="900" HorizontalAlignment="Left" Width="900"
									PlaceholderText="Egne notater om spillet (lagres på denne PC-en)" LostFocus="DesktopNotes_LostFocus" />
							</StackPanel>
							</StackPanel>
							<Border Grid.Column="1" VerticalAlignment="Top" CornerRadius="14" Background="#B3121520" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="20,16,20,18">
								<StackPanel Spacing="12">
									<TextBlock Text="DETALJER" FontSize="12" Foreground="#88FFFFFF" CharacterSpacing="80" />
									<StackPanel x:Name="DesktopFacts" Spacing="10" />
								</StackPanel>
							</Border>
						</Grid>
					</StackPanel>
				</ScrollViewer>

				<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,24,0">
					<Button Content="☰  Meny" Click="DesktopMenu_Click" ToolTipService.ToolTip="Hovedmeny (Esc)" />
					<Button Content="🎮  Konsollmodus" Click="DesktopToConsole_Click" ToolTipService.ToolTip="Bytt til fullskjerm for kontroller" />
					<Button x:Name="DesktopRandomBtn" Content="🎲" Visibility="Collapsed" Click="DesktopRandom_Click" ToolTipService.ToolTip="Velg et tilfeldig spill" />
					<Button x:Name="DesktopDownloadsBtn" Content="⬇" Click="DesktopDownloads_Click" ToolTipService.ToolTip="Nedlastinger" />
					<Button Content="📁" Click="DesktopCollections_Click" ToolTipService.ToolTip="Samlinger" />
					<Button Content="📡" Click="DesktopStream_Click" ToolTipService.ToolTip="Streaming" />
					<Button Content="⚙" Click="DesktopSettings_Click" ToolTipService.ToolTip="Innstillinger" />
				</StackPanel>
			</Grid>


			<!-- Rutenett med plakater (alternativ til liste + detaljer) -->
			<GridView x:Name="DesktopGrid" Grid.Column="1" Visibility="Collapsed" Background="#FF0C0E15" Padding="24,48,16,16"
				SelectionMode="Single" IsItemClickEnabled="False" SelectionChanged="DesktopGrid_SelectionChanged"
				DoubleTapped="DesktopList_DoubleTapped" RightTapped="DesktopList_RightTapped">
				<GridView.ItemTemplate>
					<DataTemplate x:DataType="local:TileVm">
						<Grid Width="168" Height="252" CornerRadius="10" Background="#1B1E2A" Margin="4">
							<TextBlock Text="{x:Bind Glyph}" FontSize="64" FontWeight="SemiBold" Foreground="#55FFFFFF"
								HorizontalAlignment="Center" VerticalAlignment="Center" />
							<Image Source="{x:Bind Icon}" Width="96" Height="96" Stretch="Uniform"
								HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24" />
							<TextBlock Text="{x:Bind Name}" Margin="10,10,10,38" TextWrapping="Wrap" FontSize="15"
								Foreground="#CCFFFFFF" VerticalAlignment="Bottom" MaxLines="3" TextTrimming="CharacterEllipsis" />
							<Image Source="{x:Bind Cover}" Width="168" Height="252" Stretch="UniformToFill" />
							<TextBlock Text="{x:Bind Star, Mode=OneWay}" Foreground="#FFFFD34D" FontSize="22"
								HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,10,0" />
							<Border Visibility="{x:Bind StoreVisibility}" Background="{x:Bind StoreBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
								Margin="8,0,0,8" Padding="8,2" CornerRadius="7">
								<TextBlock Text="{x:Bind StoreLabel}" FontSize="11" FontWeight="Bold" Foreground="White" CharacterSpacing="40" />
							</Border>
							<Border Visibility="{x:Bind BadgeVisibility}" HorizontalAlignment="Left" VerticalAlignment="Top"
								Margin="8,8,0,0" Padding="9,3" CornerRadius="9" Background="#E6154D33">
								<TextBlock Text="{x:Bind Badge}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
							</Border>
						</Grid>
					</DataTemplate>
				</GridView.ItemTemplate>
			</GridView>

			<!-- Venstre: søk, kategori, liste -->
			<Grid Grid.Column="0" Background="#F2101219" Padding="14,44,14,14">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<TextBox x:Name="DesktopSearch" Grid.Row="0" PlaceholderText="Søk i biblioteket  (Ctrl+F)" Margin="0,0,0,8" CornerRadius="10"
					TextChanged="DesktopSearch_TextChanged" KeyDown="DesktopSearch_KeyDown" />
				<StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,6">
					<ComboBox x:Name="DesktopFilter" HorizontalAlignment="Stretch" CornerRadius="10"
						SelectionChanged="DesktopFilter_SelectionChanged" />
					<Grid ColumnSpacing="6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ComboBox x:Name="DesktopSort" HorizontalAlignment="Stretch" CornerRadius="10"
							SelectionChanged="DesktopSort_SelectionChanged" />
						<Button x:Name="DesktopViewToggle" Grid.Column="1" Content="▦" CornerRadius="10" Padding="12,5"
							ToolTipService.ToolTip="Bytt mellom liste og rutenett" Click="DesktopViewToggle_Click" />
					</Grid>
				</StackPanel>
				<TextBlock x:Name="DesktopCount" Grid.Row="2" FontSize="12" Foreground="#77FFFFFF" Margin="4,2,0,8" CharacterSpacing="40" />
				<ListView x:Name="DesktopList" Grid.Row="3" SelectionMode="Single" IsItemClickEnabled="False"
					SelectionChanged="DesktopList_SelectionChanged" DoubleTapped="DesktopList_DoubleTapped" RightTapped="DesktopList_RightTapped">
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="local:TileVm">
							<Grid Height="60" ColumnSpacing="12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="40" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Grid Width="40" Height="54" CornerRadius="6" Background="#1B1E2A" VerticalAlignment="Center">
									<TextBlock Text="{x:Bind Glyph}" FontSize="20" Foreground="#77FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
									<Image Source="{x:Bind Icon}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
									<Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
								</Grid>
								<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
									<TextBlock Text="{x:Bind Name}" FontSize="15" Foreground="White" TextTrimming="CharacterEllipsis" />
									<TextBlock Text="{x:Bind StoreLabel}" FontSize="11" Foreground="#88FFFFFF" CharacterSpacing="60" />
								</StackPanel>
								<TextBlock Grid.Column="2" Text="{x:Bind Star, Mode=OneWay}" Foreground="#FFFFD34D" FontSize="16" VerticalAlignment="Center" />
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
				<TextBlock x:Name="DesktopEmpty" Grid.Row="3" Visibility="Collapsed" TextWrapping="Wrap" FontSize="15" Foreground="#99FFFFFF"
					Margin="8,24,8,0" VerticalAlignment="Top" IsHitTestVisible="False" />
				<Button x:Name="DesktopAddBtn" Grid.Row="4" Content="+  Legg til app" HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="0,10" CornerRadius="10" Click="DesktopAdd_Click" />
			</Grid>

			<!-- Egen tittellinje (dra her for å flytte vinduet) -->
			<Grid x:Name="DesktopTitleBar" Grid.ColumnSpan="2" Height="36" VerticalAlignment="Top" Background="Transparent">
				<TextBlock x:Name="TitleBarName" Text="ZenLauncher" FontSize="13" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False" />
			</Grid>
		</Grid>

		<!-- Pågående spill -->
		<Border x:Name="RunningBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
			Margin="0,104,0,0" Padding="24,10" CornerRadius="24" Background="#E6154D33">
			<TextBlock x:Name="RunningText" FontSize="20" Foreground="White" />
		</Border>

		<!-- Nedlasting/installasjon -->
		<Border x:Name="InstallBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
			Margin="0,170,0,0" Padding="28,16" CornerRadius="22" Background="#F2121520" BorderBrush="#26FFFFFF" BorderThickness="1">
			<StackPanel Spacing="10" Width="520">
				<TextBlock x:Name="InstallTitle" FontSize="22" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
				<ProgressBar x:Name="InstallBar" Minimum="0" Maximum="100" Height="8" IsIndeterminate="True" />
				<TextBlock x:Name="InstallDetail" FontSize="16" Foreground="#CCFFFFFF" />
			</StackPanel>
		</Border>

		<!-- Meny (innstillinger, legg til app osv.) -->
		<Grid x:Name="MenuOverlay" Visibility="Collapsed" Background="#B305060A" Tapped="MenuOverlay_Tapped">
			<Border x:Name="MenuPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Width="600" MaxHeight="900" Margin="64,110,0,0" Tapped="MenuPanel_Tapped"
				CornerRadius="28" Background="#F2121520" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="32,32,32,24">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid Margin="12,0,0,18" ColumnSpacing="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="MenuTitle" FontSize="30" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
						<Button Grid.Column="1" Content="←  Tilbake" Click="MenuBack_Click" />
						<Button Grid.Column="2" Content="✕" Click="MenuClose_Click" />
					</Grid>
					<ListView x:Name="MenuList" Grid.Row="1" SelectionMode="Single" SingleSelectionFollowsFocus="True"
						IsItemClickEnabled="True" ItemContainerStyle="{StaticResource MenuItemStyle}"
						SelectionChanged="MenuList_SelectionChanged" ItemClick="MenuList_ItemClick" PointerMoved="MenuList_PointerMoved">
						<ListView.ItemTemplate>
							<DataTemplate x:DataType="local:MenuEntry">
								<Grid Padding="{x:Bind RowPadding}" ColumnSpacing="20" Background="Transparent">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock Text="{x:Bind Title}" FontSize="{x:Bind TitleSize}" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
										<Button Content="◄" Tag="-1" Padding="10,2" Visibility="{x:Bind AdjustVisibility}" Click="MenuAdjust_Click" />
										<TextBlock Text="{x:Bind DetailText}" FontSize="{x:Bind DetailSize}" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="{x:Bind DetailMaxWidth}" VerticalAlignment="Center" />
										<Button Content="►" Tag="1" Padding="10,2" Visibility="{x:Bind AdjustVisibility}" Click="MenuAdjust_Click" />
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
					<TextBlock x:Name="MenuHint" Grid.Row="2" Text="Klikk eller A: velg     Esc eller B: tilbake     ◄ ►: juster" FontSize="15" Foreground="#66FFFFFF" Margin="12,16,0,0" />
				</Grid>
			</Border>
		</Grid>

		<!-- Innstillinger som side (desktop-modus) -->
		<Grid x:Name="SettingsPage" Visibility="Collapsed" Background="#B305060A" Tapped="SettingsPage_Tapped" PreviewKeyDown="SettingsPage_KeyDown">
			<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="980" Height="640" Margin="24" CornerRadius="16"
				Background="#F2121520" BorderBrush="#26FFFFFF" BorderThickness="1" Tapped="SettingsPanel_Tapped">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="250" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid Background="#33000000" Padding="12,20,12,12" CornerRadius="16,0,0,16">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<TextBlock Text="Innstillinger" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,16" />
						<ListView x:Name="SettingsNav" Grid.Row="1" SelectionMode="Single" SelectionChanged="SettingsNav_SelectionChanged" />
					</Grid>
					<Grid Grid.Column="1" Padding="32,20,24,20">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Grid Margin="0,0,0,8">
							<TextBlock x:Name="SettingsTitle" FontSize="26" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
							<Button Content="✕" HorizontalAlignment="Right" Click="SettingsClose_Click" />
						</Grid>
						<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
							<StackPanel x:Name="SettingsBody" Margin="0,0,8,0" />
						</ScrollViewer>
					</Grid>
				</Grid>
			</Border>
		</Grid>

		<!-- Egne skjermbilder i fullskjerm (konsollmodus) -->
		<Grid x:Name="ShotViewer" Visibility="Collapsed" Background="#F2000000">
			<Image x:Name="ShotImage" Stretch="Uniform" Margin="24" />
			<TextBlock x:Name="ShotCaption" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28" FontSize="20" Foreground="#CCFFFFFF" />
		</Grid>

		<!-- Skjermtastatur for søk (styres med kontroller) -->
		<Grid x:Name="KeyboardOverlay" Visibility="Collapsed" Background="#66000000">
			<Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="28" Background="#F2121520"
				BorderBrush="#26FFFFFF" BorderThickness="1" Padding="36">
				<StackPanel Spacing="18">
					<TextBlock x:Name="KbTitle" Text="Søk" FontSize="30" FontWeight="SemiBold" Foreground="White" />
					<Border CornerRadius="14" Background="#1AFFFFFF" Padding="20,12">
						<TextBlock x:Name="KbText" FontSize="28" Foreground="White" MinHeight="40" />
					</Border>
					<StackPanel x:Name="KbRows" Spacing="8" HorizontalAlignment="Center" />
					<TextBlock Text="A: velg tegn     Y: slett tegn     B: tøm søk (tomt: lukk)     Ferdig: lukk" FontSize="15" Foreground="#66FFFFFF" />
				</StackPanel>
			</Border>
		</Grid>

		<!-- Kort melding -->
		<Border x:Name="ToastBox" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
			Margin="0,0,0,48" Padding="28,14" CornerRadius="24" Background="#F21B1E2A">
			<TextBlock x:Name="ToastText" FontSize="20" Foreground="White" />
		</Border>

		<!-- Oppstartsskjerm: ligger over alt mens spillet starter og mens det kjører -->
		<Grid x:Name="LaunchCover" Visibility="Collapsed" Opacity="0" Background="#05060A">
			<Grid.OpacityTransition>
				<ScalarTransition Duration="0:0:0.35" />
			</Grid.OpacityTransition>
			<Image x:Name="CoverHero" Stretch="UniformToFill" Opacity="0.55" />
			<Rectangle>
				<Rectangle.Fill>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Color="#33000000" Offset="0.0" />
						<GradientStop Color="#EE05060A" Offset="1.0" />
					</LinearGradientBrush>
				</Rectangle.Fill>
			</Rectangle>
			<StackPanel VerticalAlignment="Bottom" Margin="64,0,64,72" Spacing="14">
				<TextBlock x:Name="CoverTitle" FontSize="54" FontWeight="SemiBold" Foreground="White" />
				<StackPanel Orientation="Horizontal" Spacing="16">
					<ProgressRing IsActive="True" Width="28" Height="28" Foreground="White" />
					<TextBlock x:Name="CoverStatus" FontSize="20" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
				</StackPanel>
			</StackPanel>
		</Grid>
		<Border x:Name="DimOverlay" Background="Black" Opacity="0.75" Visibility="Collapsed" IsHitTestVisible="False" />
	</Grid>
</Window>
